# Production on Vercel needs NO keys: the app calls Jev and Claude through Vercel AI Gateway
# with the project's OIDC token (team civo2 must have a card on file for AI Gateway).
#
# Optional direct providers (used instead of the gateway when set):
# TYPESAFE_API_KEY=        # Jev straight from TypeSafe
# ANTHROPIC_API_KEY=       # Claude straight from Anthropic
# AI_GATEWAY_API_KEY=      # a gateway key instead of OIDC
#
# Local development only (refused in production):
# JEV_BACKEND=mock         # heuristic stand-in for Jev, clearly labelled in the UI
# LLM_BACKEND=claude-cli   # use the Claude Code CLI logged in on this machine
